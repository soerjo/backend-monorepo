NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/my_db?schema=public

# Legacy HS256 secrets - unused since the RS256 + opaque-refresh migration.
# Kept optional for backward compatibility; safe to remove.
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=

JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=30d

# RS256 access-token keypair. Provide ONE of the two below.
# Leave EMPTY here - never commit real keys; inject them at runtime.
# UMS_JWT_PRIVATE_KEY accepts an inline PEM (literal newlines or \n-escaped).
# UMS_JWT_PRIVATE_KEY_PATH takes priority when set and the file is readable.
# The public key (and JWKS) is derived from the private key automatically.
UMS_JWT_PRIVATE_KEY=
UMS_JWT_PRIVATE_KEY_PATH=

# Initial admin seeded by `bun run seed` (idempotent). Required by the seed only.
UMS_ADMIN_EMAIL=admin@example.com
UMS_ADMIN_PASSWORD=change-me-to-a-strong-password
UMS_ADMIN_NAME=UMS Admin

# Google OAuth is disabled in UMS v1 (kept optional; unused).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Rate limiting
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=10

# Cookie secure flag (opsional; default di prod = true; set 'false' bila akses via HTTP non-HTTPS)
# COOKIE_SECURE=false

# Single-use auth tokens (password reset, email verification)
# PASSWORD_RESET tokens live for AUTH_TOKEN_TTL_MINUTES (default 60).
# EMAIL_VERIFY tokens live for AUTH_TOKEN_TTL_HOURS (default 24).
AUTH_TOKEN_TTL_MINUTES=60
AUTH_TOKEN_TTL_HOURS=24

# Mail delivery (ADR 0004): Nodemailer + SMTP Hostinger, sent directly by ums-service.
# 'log' (default) records the message in the app log — no network, used in development.
# 'smtp' sends via the relay configured below. REAL CREDENTIALS NEVER ENTER THE REPO:
# fill these at runtime only. Host/port MUST be confirmed in hPanel — Hostinger has two
# email products (Hostinger Email / Titan Email) with different hosts.
MAIL_TRANSPORT=log
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
APP_WEB_URL=http://localhost:5173
