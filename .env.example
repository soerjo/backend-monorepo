NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/my_db?schema=public
# UMS (User Management Service) JWT verification — exactly ONE of these two is required
UMS_JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nMIIBIjANBg...\n-----END PUBLIC KEY-----

# File Service (upstream minio-file-service)
FILE_SERVICE_URL=http://localhost:3100/api
FILE_SERVICE_EMAIL=admin@example.com
FILE_SERVICE_PASSWORD=secret
FILE_SERVICE_TIMEOUT_MS=10000

CORS_ORIGINS=http://localhost:5173
