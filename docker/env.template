# ==============================================================================
# GLOBAL INFRASTRUCTURE CONFIGURATION
# ==============================================================================
NODE_ENV=development

# PostgreSQL (Single instance hosting multi-db)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Kafka & Kafbat UI
KAFKA_BROKERS=localhost:9092
KAFBAT_UI_PORT=8080

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=app-uploads

# Mailpit (Local SMTP)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=noreply@example.com

# ==============================================================================
# SERVICE PORTS & DATABASE URLS
# ==============================================================================

# 1. UMS Service (Identity Provider & Auth)
UMS_PORT=3001
UMS_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ums_db?schema=public
UMS_ADMIN_EMAIL=admin@example.com
UMS_ADMIN_PASSWORD=change-me-to-a-strong-password
UMS_ADMIN_NAME="UMS Admin"

# 2. CMS Service (Content Management)
CMS_PORT=3002
CMS_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cms_db?schema=public
CMS_UMS_JWKS_URL=http://localhost:3001/.well-known/jwks.json

# 3. POS Service (Point of Sale)
POS_PORT=3003
POS_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pos_db?schema=public
POS_UMS_JWKS_URL=http://localhost:3001/.well-known/jwks.json
POS_KAFKA_BROKERS=localhost:9092

# 4. WMS Service (Warehouse Management)
WMS_PORT=3004
WMS_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wms_db?schema=public
WMS_UMS_JWKS_URL=http://localhost:3001/.well-known/jwks.json
WMS_KAFKA_BROKERS=localhost:9092

# 5. Billing Service (Payment & Midtrans)
BILLING_PORT=3005
BILLING_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/billing_db?schema=public
BILLING_REDIS_URL=redis://localhost:6379
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxx
MIDTRANS_IS_PRODUCTION=false

# 6. MinIO File Service (Object Storage)
FILE_PORT=3006
FILE_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/file_db?schema=public
FILE_MINIO_ENDPOINT=localhost
FILE_MINIO_PORT=9000
FILE_MINIO_ACCESS_KEY=minioadmin
FILE_MINIO_SECRET_KEY=minioadmin
FILE_MINIO_BUCKET=app-uploads

# 7. Notification Service (BullMQ & Notification Dispatcher)
NOTIFICATION_PORT=3007
NOTIFICATION_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/notification_db?schema=public
NOTIFICATION_REDIS_URL=redis://localhost:6379
