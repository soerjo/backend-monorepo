{
  "name": "backend-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "bun@1.4.4",
  "description": "Centralized backend monorepo for microservices ecosystem (UMS, CMS, POS, WMS, Billing, File, Notification)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:cov": "turbo run test:cov",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write \"{apps,packages}/**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"{apps,packages}/**/*.{ts,js,json,md}\"",
    "prisma:generate": "turbo run prisma:generate",
    "docker:up": "docker compose -f docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.yml down",
    "docker:logs": "docker compose -f docker/docker-compose.yml logs -f"
  },
  "devDependencies": {
    "prettier": "^3.5.1",
    "turbo": "^2.11.10",
    "typescript": "^5.7.3",
    "dotenv": "^16.4.7",
    "@types/dotenv": "^8.2.3"
  }
}
