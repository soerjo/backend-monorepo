{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "prisma:generate": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build", "prisma:generate"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["prisma:generate"],
      "outputs": ["coverage/**"]
    },
    "test:cov": {
      "dependsOn": ["prisma:generate"],
      "outputs": ["coverage/**"]
    },
    "test:e2e": {
      "dependsOn": ["build"]
    }
  }
}
